# Copy this file to .env for local runs. Never commit .env.

# LLM backend: "groq" (real model) or "mock" (no model, only for API wiring tests)
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30

# Embeddings: "fastembed" (small local model, default), "hf" (Hugging Face API, needs credits)
# or "local" (offline hashing, only for wiring tests)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only used when EMBEDDING_BACKEND=hf
HF_TOKEN=
HF_PROVIDER=hf-inference

# Knowledge base folder and a simple per-IP request limit (0 turns the limit off)
RAG_DATA_DIR=data
RATE_LIMIT_PER_MINUTE=20
